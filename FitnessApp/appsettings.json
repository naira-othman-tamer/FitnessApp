{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "profile-route": {
        "ClusterId": "profile-cluster",
        "Match": {
          "Path": "/api/v1/profile/{**catch-all}"
        }
      },
      "settings-route": {
        "ClusterId": "profile-cluster",
        "Match": {
          "Path": "/api/v1/settings/{**catch-all}"
        }
      },
      "nutrition-route": {
        "ClusterId": "nutrition-cluster",
        "Match": {
          "Path": "/api/v1/nutrition/{**catch-all}"
        }
      },
      "fce-route": {
        "ClusterId": "fce-cluster",
        "Match": {
          "Path": "/api/v1/fce/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/fce"
          }
        ]
      },
      "workout-route": {
        "ClusterId": "workout-cluster",
        "Match": {
          "Path": "/api/v1/workout/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/workout"
          }
        ]
      },
      "progress-route": {
        "ClusterId": "progress-cluster",
        "Match": {
          "Path": "/api/v1/progress/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/v1/progress"
          }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth": {
            "Address": "http://authenticationservice:8080/"
          }
        }
      },
      "profile-cluster": {
        "Destinations": {
          "profile": {
            "Address": "http://profileservice:8080/"
          }
        }
      },
      "nutrition-cluster": {
        "Destinations": {
          "nutrition": {
            "Address": "http://nutritionservice:8080/"
          }
        }
      },
      "fce-cluster": {
        "Destinations": {
          "fce": {
            "Address": "http://fce:8080/"
          }
        }
      },
      "workout-cluster": {
        "Destinations": {
          "workout": {
            "Address": "http://workoutservice:8080/"
          }
        }
      },
      "progress-cluster": {
        "Destinations": {
          "progress": {
            "Address": "http://progresstrackingservice:8080/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
